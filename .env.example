# ==============================================================================
# SyncShelf Environment Variables (Template / Placeholders Only)
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env.local for development.
# ==============================================================================

# Public Web Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Web Client SDK (Public configuration)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional database URL (if Realtime Database presence is used in later milestones)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# Firebase Admin SDK (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: Private key must be enclosed in quotes and newlines preserved or escaped as \n
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkughiqijhkiG9iubw0BhbuybuuhAQEFAASCBKgwggSkAguygugEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (SERVER ONLY - Private bucket, S3-compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=syncshelf-private
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Max upload size in bytes (MVP default: 25 MB = 26214400 bytes)
MAX_UPLOAD_SIZE_BYTES=26214400

# ------------------------------------------------------------------------------
# Upstash Redis REST (SERVER ONLY - Cache & Rate Limiting)
# Optional in early dev; system falls back gracefully to direct Firestore if missing
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN
